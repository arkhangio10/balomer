{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase",
  "description": "The kick-off or the end of a half.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "phase", "half"],
  "properties": {
    "type": { "const": "phase" },
    "phase": { "type": "string", "enum": ["kickoff", "end"] },
    "half": { "$ref": "frame.schema.json#/$defs/Half" }
  }
}
