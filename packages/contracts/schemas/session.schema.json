{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "description": "Opens a replayed half: the match, the half and the pitch it is played on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "match_id", "half", "pitch_length_m", "pitch_width_m", "credit"],
  "properties": {
    "type": { "const": "session" },
    "match_id": { "type": "string", "minLength": 1 },
    "half": { "$ref": "frame.schema.json#/$defs/Half" },
    "pitch_length_m": { "type": "number", "exclusiveMinimum": 0 },
    "pitch_width_m": { "type": "number", "exclusiveMinimum": 0 },
    "credit": {
      "type": "string",
      "minLength": 1,
      "description": "Data credit shown on the clock bar."
    }
  }
}
