{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "description": "A halftime or full-time report. It is ok only after validation, and then has exactly three recommendations.",
  "oneOf": [{ "$ref": "#/$defs/ReportOk" }, { "$ref": "#/$defs/ReportUnavailable" }],
  "$defs": {
    "ReportKind": { "type": "string", "enum": ["halftime", "fulltime"] },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "adjustment", "evidence"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "adjustment": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "metrics.schema.json#/$defs/Evidence" }
        }
      }
    },
    "ReportOk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "status", "recommendations"],
      "properties": {
        "type": { "const": "report" },
        "kind": { "$ref": "#/$defs/ReportKind" },
        "status": { "const": "ok" },
        "recommendations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/Recommendation" }
        }
      }
    },
    "ReportUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "status"],
      "properties": {
        "type": { "const": "report" },
        "kind": { "$ref": "#/$defs/ReportKind" },
        "status": { "const": "unavailable" }
      }
    }
  }
}
