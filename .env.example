# Copy to .env and fill in. .env is git-ignored and Claude Code cannot read it.

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=balomer

# --- IoT Core ---
BALOMER_IOT_ENDPOINT=
BALOMER_IOT_TOPIC=balomer/match/tracks

# --- DynamoDB ---
BALOMER_TABLE_NAME=

# --- Bedrock / AgentCore ---
BALOMER_BEDROCK_MODEL_ID=
BALOMER_KNOWLEDGE_BASE_ID=
BALOMER_GUARDRAIL_ID=

# --- Fire TV client ---
BALOMER_WEBSOCKET_URL=

# --- Edge worker ---
BALOMER_CAMERA_URL=
BALOMER_LOG_LEVEL=INFO
