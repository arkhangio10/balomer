{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(gh *)",
      "Bash(aws *)",
      "Bash(cdk deploy *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(choco install *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(pre-commit run *)"
    ]
  }
}
